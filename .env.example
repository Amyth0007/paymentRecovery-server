NODE_ENV=development
PORT=4000
# PostgreSQL (Supabase). Use the TRANSACTION POOLER for the app (port 6543, works with many short connections):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payment_recovery
DATABASE_URL=
# Direct / session connection (port 5432) used only to run migrations at startup and by drizzle-kit.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
# Connections each API instance keeps open to the pooler. Instances x DB_POOL_MAX must stay below
# your Supabase pool size (Database settings > Connection pooling).
DB_POOL_MAX=10
# Set to false only for a local Postgres without TLS when the host is not localhost.
DB_SSL=
# Apply pending migrations from ./drizzle on startup.
RUN_MIGRATIONS=
CLIENT_ORIGIN=http://localhost:5173
# Google OAuth web client; register the callback URI below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gmail/oauth/callback
# 32 random bytes encoded as 64 hex characters. Keep stable across deploys and back it up.
GMAIL_TOKEN_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=replace-this-development-secret-32
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
# Optional. When both email and password are set, the API creates this Super Admin once.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
# Master password a platform super admin enters to open any organization as its admin (min 12 chars).
# Leave empty to disable organization access.
MASTER_PASSWORD=
# Optional Cloudinary storage. If unset, development uploads use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
