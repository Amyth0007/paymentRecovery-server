NODE_ENV=development
PORT=4000
# Connect to a local MongoDB server.
MONGODB_URI=mongodb://127.0.0.1:27017/payment_recovery
CLIENT_ORIGIN=http://localhost:5173
# Google OAuth web client; register the callback URI below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gmail/oauth/callback
# 32 random bytes encoded as 64 hex characters. Keep stable across deploys and back it up.
GMAIL_TOKEN_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=replace-this-development-secret-32
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
# Optional. When both email and password are set, the API creates this Super Admin once.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
# Optional Cloudinary storage. If unset, development uploads use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
